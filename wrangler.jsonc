{
  // ANCHOR on Cloudflare Workers (static assets + the two functions), a standalone twin of the
  // Vercel deploy. Deploy: npx wrangler deploy (or connect this repo in Cloudflare Workers Builds).
  "name": "anchor-autopilot",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "observability": { "enabled": true }
}
